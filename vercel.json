{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "https://giftreward-backend.vercel.app/api/:path*" },
    { "source": "/go/:path*", "destination": "https://giftreward-backend.vercel.app/go/:path*" },
    { "source": "/postback/:path*", "destination": "https://giftreward-backend.vercel.app/postback/:path*" },
    { "source": "/report/:path*", "destination": "https://giftreward-backend.vercel.app/report/:path*" },
    { "source": "/tracking/:path*", "destination": "https://giftreward-backend.vercel.app/tracking/:path*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
